# Registration reports can contain live plaintext client secrets.
# Reports are written to the invocation directory with arbitrary app names.
*.txt

# Rust build output (keep Cargo.lock tracked)
/target/

# Rust formatter backups and profiling output
*.rs.bk
*.profraw
*.profdata

# Release archives and checksums generated by the release workflow
/dist/

# Local IDE state
.idea/

# macOS metadata
.DS_Store
